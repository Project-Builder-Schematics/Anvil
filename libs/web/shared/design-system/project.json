{
  "name": "web-shared-design-system",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/shared/design-system/src",
  "prefix": "ds",
  "projectType": "library",
  "tags": ["scope:web", "context:shared", "type:ui"],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "libs/web/shared/design-system/tsconfig.spec.json",
        "buildTarget": "web:build:development",
        "watch": false,
        "coverage": true,
        "coverageExclude": [
          "**/*.spec.ts",
          "**/index.ts",
          "**/tokens/contract.ts"
        ],
        "coverageThresholds": {
          "lines": 70,
          "branches": 70,
          "functions": 70,
          "statements": 70
        },
        "coverageInclude": ["libs/web/shared/design-system/src/**/*.ts"]
      }
    }
  }
}
