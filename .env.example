# Dev defaults. Copy to .env to override; `docker compose` and `bun run dev` both read it.
# docker-compose.yml repeats these as `${VAR:-default}` so it works with no .env at all;
# tools/dev/infra.test.ts fails if the two drift apart.
# Published ports are bound to 127.0.0.1 only. Change these credentials before sharing a machine.

# Shared Postgres and pgadmin (one instance for all worktrees)
DB_PORT=5432
DB_USER=demo
DB_PASSWORD=demo
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=demo

# Overridden per worktree by `bun run dev` (see the README); used as-is by plain `docker compose`
DB_NAME=demo
API_PORT=3000
DEBUG_PORT=9229
WEB_PORT=4200
CORS_ORIGIN=http://localhost:4200
